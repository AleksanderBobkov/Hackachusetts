# Backend (FastAPI + orchestrator). Instance name = the Linux user that owns the checkout.
#   sudo cp deploy/pi/companion-backend@.service /etc/systemd/system/
#   sudo systemctl enable --now companion-backend@$USER
[Unit]
Description=Companion backend (%i)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=%i
# The backend reads TALK/MUTE from /dev/input (evdev, Phase 1) and plays audio itself.
SupplementaryGroups=input audio
WorkingDirectory=/home/%i/Hackachusetts
# Provider keys live in this file (never in the UI). Optional; leave it out for PROVIDER=mock.
EnvironmentFile=-/home/%i/Hackachusetts/.env
Environment=PYTHONUNBUFFERED=1
# Bind to localhost only. To open /setup from a laptop, change to --host 0.0.0.0
# (the setup API has no sign-in: only do that on a trusted network).
ExecStart=/home/%i/Hackachusetts/.venv/bin/uvicorn companion.api.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
