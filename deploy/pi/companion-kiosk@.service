# Full-screen companion UI on Raspberry Pi OS Lite (no desktop): cage (a single-app Wayland
# compositor) runs Chromium in kiosk mode on tty1. Instance name = the Linux user.
#   sudo cp deploy/pi/companion-kiosk@.service /etc/systemd/system/
#   sudo systemctl disable getty@tty1        # cage takes over tty1
#   sudo systemctl set-default graphical.target
#   sudo systemctl enable --now companion-kiosk@$USER
[Unit]
Description=Companion kiosk (cage + Chromium, %i)
After=systemd-user-sessions.service plymouth-quit-wait.service companion-backend@%i.service
Wants=companion-backend@%i.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=%i
SupplementaryGroups=audio video render
# A real logind session on tty1 so cage can open the display (DRM) and input devices.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# Wait until the backend answers so Chromium never shows its own error page.
ExecStartPre=/bin/sh /home/%i/Hackachusetts/deploy/pi/wait-for-backend.sh
TimeoutStartSec=100
ExecStart=/bin/sh /home/%i/Hackachusetts/deploy/pi/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
